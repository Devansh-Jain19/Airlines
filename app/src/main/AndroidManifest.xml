<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network Permissions -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application
        android:name=".AirlineApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_flight"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_flight"
        android:supportsRtl="true"
        android:theme="@style/Theme.AirlineApp"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- Main Search Screen (Home) -->
        <activity
            android:name=".ui.search.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Authentication Screens -->
        <activity
            android:name=".ui.auth.LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".ui.auth.RegisterActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Flight Search Results Screen -->
        <activity
            android:name=".ui.flights.FlightListActivity"
            android:exported="false" />

        <!-- Seat Selection Map Screen -->
        <activity
            android:name=".ui.seats.SeatSelectionActivity"
            android:exported="false" />

        <!-- Checkout & Payment Screen -->
        <activity
            android:name=".ui.booking.CheckoutActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize" />

        <!-- Boarding Pass Screen -->
        <activity
            android:name=".ui.ticket.BoardingPassActivity"
            android:exported="false" />

        <!-- Booking History Screen -->
        <activity
            android:name=".ui.ticket.MyBookingsActivity"
            android:exported="false" />

        <!-- User Profile Screen -->
        <activity
            android:name=".ui.profile.ProfileActivity"
            android:exported="false" />

    </application>

</manifest>
