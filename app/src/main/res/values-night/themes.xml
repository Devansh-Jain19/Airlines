<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.AirlineApp" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/accent</item>
        <item name="colorPrimaryDark">#0B1120</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">#0B1120</item>
        <item name="android:navigationBarColor">#0F172A</item>
        <item name="android:windowBackground">#0B1120</item>
    </style>

    <style name="AirlineCard" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">3dp</item>
        <item name="cardBackgroundColor">#1E293B</item>
        <item name="strokeColor">#334155</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="AirlinePrimaryButton" parent="Widget.Material3.Button">
        <item name="cornerRadius">12dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:textStyle">bold</item>
        <item name="backgroundTint">@color/accent</item>
        <item name="android:textColor">#0F172A</item>
    </style>
</resources>
